# Template with no secrets. Copy to .env (git-ignored), fill in, then load it in your shell:
#   set -a
#   source .env
#   set +a
# The program reads environment variables only; it does not load .env by itself.

# Provider: anthropic | ollama | gateway
SRAG_LLM_PROVIDER=gateway

# Model: required for gateway (service name: catalog.schema.service); optional for the others
SRAG_LLM_MODEL=

# gateway (Databricks Unity Gateway)
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# anthropic
ANTHROPIC_API_KEY=

# ollama (default http://localhost:11434)
SRAG_OLLAMA_URL=
